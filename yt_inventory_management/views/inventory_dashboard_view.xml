<odoo>
    <record id="view_inventory_dashboard" model="ir.ui.view">
        <field name="name">inventory.dashboard.form</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <form string="Inventory Dashboard">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="reorder_alert"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

  
    <record id="action_inventory_dashboard" model="ir.actions.act_window">
        <field name="name">Inventory Dashboard</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inventory_dashboard"/>
        <field name="target">current</field>
    </record>
</odoo>
